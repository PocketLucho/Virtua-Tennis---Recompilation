# Builds libvt_game.so (the recompiled game code) from the sources generated from YOUR ROM.
# Used by build_game.sh. Needs g++ (or clang++) and make.
CXX ?= g++
CXXFLAGS = -std=c++17 -O2 -fPIC -fno-strict-aliasing -fvisibility=hidden -w -DNDEBUG -Isdk/core -Isdk/core/deps -Isdk/core/deps/nowide/include
SRCS = $(sort $(wildcard gen/aot_gen_*.cpp)) sdk/core/hw/sh4/aot/aot_dll_shim.cpp
OBJS = $(addprefix obj/,$(notdir $(SRCS:.cpp=.o)))
OUT = ../libvt_game.so

vpath %.cpp gen sdk/core/hw/sh4/aot

all: $(OUT)

obj/%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(OUT): $(OBJS)
	$(CXX) -shared -Wl,-Bsymbolic -Wl,--no-undefined -s -o $@ $(OBJS) -lm
